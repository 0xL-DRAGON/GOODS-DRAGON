SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# نمایش راهنما با -h
if [[ "$1" == "-h" ]] || [[ "$1" == "--help" ]]; then
    cat << 'EOF'
🐉 Dragon Eye - Advanced Pentesting & Bug Bounty Tool
========================================================
Author: zeus (z4) | Telegram: @iM_z4
Version: 1.1.0

Usage:
  dragon-eye [COMMAND] [OPTIONS]

Commands:
  recon   - Reconnaissance: Subdomain, Wayback, Active, Takeover, Cloud
  web     - Web Vulnerabilities: SQLi, XSS, CMS, CVE, Headers, JS, Tech, Git, WAF, IDOR, SSTI, SSRF, LFI, CORS, JWT, Open Redirect, GraphQL, Rate Limit, 2FA, Param Discovery, Blind XSS, Secret, Version, Broken Link, Fuzz, Business Logic, Race Condition, Chained Attack, Static Analysis, API Scanner
  scan    - Network Scan: Port, Host Discovery, SSL, S3, Brute Force
  update  - Self-update from GitHub
  help    - Show this help

Options:
  -t, --target    Target domain or IP
  -th, --threads  Number of threads (default: 30)
  -v, --verbose   Verbose mode
  --report        Generate HTML report
  --report-all    Generate all report formats

Examples:
  dragon-eye recon -t example.com --active-scan -v
  dragon-eye web -t https://example.com --sqli --xss -v --report
  dragon-eye scan -t 192.168.1.1 -p 22,80,443 -b -v
  dragon-eye update

For more info, contact @iM_z4 on Telegram
========================================================
EOF
    exit 0
fi

# اگر آرگومانی وجود نداشت، منوی گرافیکی
if [[ $# -eq 0 ]]; then
    python main.py
    exit 0
fi

# اجرای دستورات
python main.py "$@"
